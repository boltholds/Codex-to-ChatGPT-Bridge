# Command used to launch the official Codex MCP server.
BRIDGE_CODEX_COMMAND=codex
BRIDGE_CODEX_ARGS=mcp-server
BRIDGE_CODEX_TIMEOUT_SECONDS=21600

# JSON array of directories that Codex sessions may use as cwd.
# Windows example: ["C:\\Users\\you\\Documents\\Code"]
BRIDGE_ALLOWED_ROOTS=["."]

# Local durable state. Keep it outside Git.
BRIDGE_MEMORY_PATH=.bridge/memory.jsonl
BRIDGE_SESSIONS_PATH=.bridge/sessions.json

# stdio is the default for local MCP clients.
BRIDGE_TRANSPORT=stdio
BRIDGE_DEFAULT_SANDBOX=workspace-write
BRIDGE_DEFAULT_APPROVAL_POLICY=never

# Context, response, event, and thread budgets.
BRIDGE_MAX_MEMORY_ITEMS=12
BRIDGE_MAX_MEMORY_CONTEXT_CHARS=12000
BRIDGE_MAX_CODEX_RESPONSE_CHARS=12000
BRIDGE_MAX_EVENT_TEXT_CHARS=2000
BRIDGE_MAX_SESSION_EVENTS=50
BRIDGE_MAX_SESSION_TURNS=20
